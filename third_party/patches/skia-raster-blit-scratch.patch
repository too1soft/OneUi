-SkBlitter::~SkBlitter() {}
+namespace {
+constexpr size_t kMaxCachedBlitBytes = 64 * 1024;
+
+// Keep at most one idle buffer per thread. The owning blitter holds its
+// buffer until destruction, including through nested draws.
+thread_local bool blitMemoryCacheDestroyed = false;
+struct BlitMemoryCache {
+    SkAutoMalloc buffer;
+
+    ~BlitMemoryCache() { blitMemoryCacheDestroyed = true; }
+};
+
+SkAutoMalloc* cachedBlitMemory() {
+    if (blitMemoryCacheDestroyed) return nullptr;
+    static thread_local BlitMemoryCache cache;
+    return &cache.buffer;
+}
+}  // namespace
+
+void* SkBlitter::allocBlitMemory(size_t size) {
+    if (size && size <= kMaxCachedBlitBytes && !fBlitMemory.get()) {
+        if (auto* cache = cachedBlitMemory(); cache && cache->size() >= size) {
+            fBlitMemory.swap(*cache);
+        }
+    }
+    return fBlitMemory.reset(size, SkAutoMalloc::kReuse_OnShrink);
+}
+
+SkBlitter::~SkBlitter() {
+    if (fBlitMemory.get() && fBlitMemory.size() <= kMaxCachedBlitBytes) {
+        if (auto* cache = cachedBlitMemory(); cache && cache->size() < fBlitMemory.size()) {
+            fBlitMemory.swap(*cache);
+        }
+    }
+}
 
