<template>
  <Page>
    <Header title="连接详情">
      <Text text="已保存的本地配置 · 状态为固定模拟数据，不发起网络连接。" />
      <Toolbar>
        <Button ref="detailBack" @click="list.detailBack">返回连接列表</Button>
        <Select :items="editor.themes" v-model="editor.theme" name="详情页主题" />
        <Select :items="editor.densities" v-model="editor.density" name="界面密度" />
      </Toolbar>
    </Header>
    <DetailPage>
      <Section title="连接信息">
        <FormGrid>
          <FormRow label="连接名称"><Text :text="list.detailName" /></FormRow>
