# Only the unified demo depends on Cargo. All hosts reuse their fixed Rust output.
find_program(lab_cargo cargo REQUIRED)
if(DEFINED ENV{CARGO_TARGET_DIR})
  set(lab_rust_target_default "$ENV{CARGO_TARGET_DIR}")
elseif(WIN32)
  set(lab_rust_target_default "${ONEUI_SOURCE_ROOT}/bindings/rust/target")
else()
  set(lab_rust_target_default "${CMAKE_CURRENT_BINARY_DIR}/rust")
endif()
set(ONEUI_LAB_RUST_TARGET_DIR "${lab_rust_target_default}" CACHE PATH "Reusable Rust build output")
set(lab_owner_dir "${ONEUI_LAB_RUST_TARGET_DIR}/debug")
if(WIN32)
  set(lab_owner_library "${lab_owner_dir}/oneui_lab_owner.dll")
  set(lab_owner_import "${lab_owner_dir}/oneui_lab_owner.dll.lib")
elseif(APPLE)
  set(lab_owner_library "${lab_owner_dir}/liboneui_lab_owner.dylib")
else()
  set(lab_owner_library "${lab_owner_dir}/liboneui_lab_owner.so")
endif()
add_custom_target(oneui-lab-rust-owner
  COMMAND "${CMAKE_COMMAND}" -E env "ONEUI_LIB_DIR=$<TARGET_LINKER_FILE_DIR:oneui>"
    "CARGO_TARGET_DIR=${ONEUI_LAB_RUST_TARGET_DIR}" "${lab_cargo}" build
    --manifest-path "${ONEUI_SOURCE_ROOT}/bindings/rust/Cargo.toml" -p oneui-lab-owner
  DEPENDS oneui
  BYPRODUCTS "${lab_owner_library}" ${lab_owner_import}
  VERBATIM)
add_library(oneui_lab_owner SHARED IMPORTED GLOBAL)
set_target_properties(oneui_lab_owner PROPERTIES IMPORTED_LOCATION "${lab_owner_library}")
if(WIN32)
  set_target_properties(oneui_lab_owner PROPERTIES IMPORTED_IMPLIB "${lab_owner_import}")
endif()
add_dependencies(oneui_lab_owner oneui-lab-rust-owner)
set(lab_terminal_sources terminal/sessions.cpp terminal/files.cpp terminal/activity.cpp terminal/workspace.cpp)
function(oneui_lab_terminal target)
  target_sources(${target} PRIVATE ${lab_terminal_sources})
  target_link_libraries(${target} PRIVATE oneui_lab_owner)
  oneui_target_view(${target} NAME TerminalWorkbench SOURCE views/TerminalWorkbench.one)
  if(WIN32)
    add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
      "${lab_owner_library}" "$<TARGET_FILE_DIR:${target}>")
  else()
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${lab_owner_dir}" "${ONEUI_EXISTING_BUILD_DIR}")
  endif()
endfunction()
oneui_lab_terminal(oneui-performance-lab)
add_executable(oneui-lab-terminal-tests EXCLUDE_FROM_ALL terminal_tests.cpp terminal_dock_tests.cpp)
target_link_libraries(oneui-lab-terminal-tests PRIVATE oneui)
target_include_directories(oneui-lab-terminal-tests PRIVATE "${ONEUI_SOURCE_ROOT}/src")
if(MSVC)
  target_compile_options(oneui-lab-terminal-tests PRIVATE /utf-8)
  target_compile_definitions(oneui-lab-terminal-tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  set_target_properties(oneui-lab-terminal-tests PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreaded)
endif()
oneui_lab_terminal(oneui-lab-terminal-tests)
add_executable(oneui-lab-gesture-tests EXCLUDE_FROM_ALL "${ONEUI_SOURCE_ROOT}/tests/dock_gesture_tests.cpp")
target_link_libraries(oneui-lab-gesture-tests PRIVATE oneui)
if(MSVC)
  target_compile_options(oneui-lab-gesture-tests PRIVATE /utf-8)
  set_target_properties(oneui-lab-gesture-tests PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreaded)
endif()
