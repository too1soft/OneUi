<template view-model="Root">
  <Column>
    <FontPicker :items="fonts" :selected="font" :loading="loading" :error="error"
                @selectionRequested="selectFont" @retryRequested="retry"/>
    <MediaPicker :asset="asset" :label="label" :loading="loading" :error="error"
                 @chooseRequested="choose" @clearRequested="clear" @cancelRequested="cancel">
      <Text slot="empty" text="Choose a local image"/>
      <Text slot="error" :text="error"/>
    </MediaPicker>
    <MediaPreview :source="asset" fit="cover" position="bottom-right" :opacity="level" @loadFailed="failed">
      <Text slot="empty" text="No image"/>
    </MediaPreview>
    <Slider :minimum="minimum" :maximum="maximum" step="0.01" v-model="level" @interaction="adjust"/>
    <ThemeScope :tokens="colors"><Card><Text text="Scoped sample"/></Card></ThemeScope>
    <DataMenu :title="label" :subtitle="error" :items="menu" @menuActivated="menuActivated"/>
    <Popup :open="popupOpen" anchor-x="300" anchor-y="220" anchor-width="10" anchor-height="10"
           content-width="180" content-height="100" @closed="popupClosed"><Button text="Action"/></Popup>
  </Column>
</template>
