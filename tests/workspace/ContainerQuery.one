<template view-model="QueryRoot">
  <Column class="shell">
    <Column class="columns" grow="1" basis="0">
      <ContainerPage class="tree" :selected="treeSelected"><Text text="Tree"/></ContainerPage>
      <ContainerPage class="browser" :selected="browserSelected"><Text text="Browser"/></ContainerPage>
      <ContainerPage class="details" :selected="detailsSelected"><Text text="Details"/></ContainerPage>
    </Column>
  </Column>
</template>
<style scoped>
.shell {container-name:sftp;container-type:size;}
.tree {flex-basis:80px;}
@container sftp (width >= 860px) and (height > 0px) and (aspect-ratio >= 8/5) {
  .columns {flex-direction:row;gap:12px;}
  .tree {display:flex;flex-basis:224px;flex-shrink:0;}
  .browser {display:flex;flex-basis:0px;flex-grow:1;}
  .details {display:none;}
}
@container sftp (width >= 1100px) and (height > 0px) and (aspect-ratio >= 8/5) {
