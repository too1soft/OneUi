model Root {
  r resources:list<ResourceRow>
  command selectResource(index:i64,selected:bool)
  r fonts: list<FontItem>
  r colors: list<ColorToken>
  r font: utf8
  r asset: utf8
  r label: utf8
  r loading: bool
  r error: utf8
  r minimum: f64
  r maximum: f64
  rw level: f64
  command selectFont(key:utf8)
  command retry()
  command choose()
  command clear()
  command cancel()
  command failed(source:utf8,code:utf8,message:utf8)
  command adjust(phase:i64,value:f64)
  r menu: list<MenuEntry>
  command menuActivated(id:utf8)
  r popupOpen:bool
  command popupClosed()
}
model FontItem key id {r id:utf8;r family:utf8;r label:utf8;r available:bool}
model ColorToken key id {r id:utf8;r rgba:i64}
model MenuEntry key id {
  r id:utf8; r parent:utf8; r text:utf8; r icon:utf8; r shortcut:utf8
  r disabled:bool; r checked:bool; r danger:bool; r separator:bool; r header:bool
}

model ResourceRow key id {r id:utf8 r title:utf8 r detail:utf8 r selected:bool}
