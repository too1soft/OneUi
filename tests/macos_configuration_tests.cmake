set(module "${CMAKE_CURRENT_LIST_DIR}/../cmake/OneUIMacOS.cmake")
if(DEFINED CASE)
    # Simulates configuration inputs only; does not emulate a Mac compiler.
    set(CMAKE_SYSTEM_NAME Darwin)
    unset(ENV{MACOSX_DEPLOYMENT_TARGET})
    if(CASE STREQUAL "environment")
        set(ENV{MACOSX_DEPLOYMENT_TARGET} "14.0")
    elseif(CASE STREQUAL "explicit")
        set(CMAKE_OSX_DEPLOYMENT_TARGET "14.5")
    elseif(CASE STREQUAL "too-old")
        set(CMAKE_OSX_DEPLOYMENT_TARGET "12.0")
    elseif(CASE STREQUAL "empty")
        set(CMAKE_OSX_DEPLOYMENT_TARGET "")
    elseif(CASE STREQUAL "linux")
        set(CMAKE_SYSTEM_NAME Linux)
    endif()
    include("${module}")
    if(CASE STREQUAL "default" AND NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "13.0")
        message(FATAL_ERROR "Wrong default baseline")
    elseif(CASE STREQUAL "environment" AND NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "14.0")
        message(FATAL_ERROR "Environment baseline was ignored")
    elseif(CASE STREQUAL "explicit" AND NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "14.5")
        message(FATAL_ERROR "Explicit baseline was overwritten")
    elseif(CASE STREQUAL "linux" AND DEFINED CMAKE_OSX_DEPLOYMENT_TARGET)
        message(FATAL_ERROR "Apple configuration leaked into Linux")
    endif()
    return()
endif()
foreach(case default environment explicit too-old empty linux)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case STREQUAL "too-old" OR case STREQUAL "empty")
        if(status EQUAL 0 OR NOT error MATCHES "OneUI requires CMAKE_OSX_DEPLOYMENT_TARGET")
            message(FATAL_ERROR "Invalid baseline was not rejected: ${case}: ${output}${error}")
        endif()
    elseif(NOT status EQUAL 0)
        message(FATAL_ERROR "Baseline test failed: ${case}: ${output}${error}")
    endif()
endforeach()
message(STATUS "macOS deployment configuration cases passed (no Mac build performed)")
