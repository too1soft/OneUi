<template view-model="Root">
  <Column>
    <Text :class="title" :text="title"/>
    <Input v-model="title"/>
    <Button text="Run" @click="click"/>
    <Text v-if="visible" text="conditional"/>
    <Text v-for="item in rows" :key="item.id" :text="item.text"/>
    <NativeHost host="terminal"/>
    <StateView :title="title" :message="title" :action="title" icon="server" @action="click"/>
    <Surface name="child-slot" grow="1"/>
    <Checkbox text="permission" tooltip="Permission toggle" v-model="checked"/>
    <InteractiveSurface @drag="drag"><Text text="Drag"/></InteractiveSurface>
  <Row :class="title"><Text text="first"/><Text text="second"/><Progress value="0.5" class="paint-progress"/><TimeSeriesChart :series="series" :sample-positions="positions" :axis-labels="labels" range-min="0" range-max="100" grid-lines="3" grid-style="0 0.7" smooth="false" area-fill="false" dashed-grid="false" axes-visible="false" latest-point="true" line-width="1.8" fill-alpha="24" plot-insets="10 8 19 36" @inspection="inspect"/></Row>
  </Column>
</template>

<style scoped>Text { font-size: 13px; } Row.initial { flex-direction:row; } Row.changed { flex-direction:column; }Progress.paint-progress {color:#c09030;background:#102030;border-radius:3px;} </style>
