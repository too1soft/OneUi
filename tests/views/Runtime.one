<template view-model="Root">
  <Column>
    <Text :class="title" :text="title"/>
    <Input v-model="title"/>
    <Button text="Run" @click="click"/>
    <Text v-if="visible" text="conditional"/>
    <Text v-for="item in rows" :key="item.id" :text="item.text"/>
    <NativeHost host="terminal"/>
    <StateView :title="title" :message="title" :action="title" icon="server" @action="click"/>
    <Surface name="child-slot" grow="1"/>
  </Column>
</template>

<style scoped>Text { font-size: 13px; }</style>
