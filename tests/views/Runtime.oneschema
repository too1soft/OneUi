model Root {
    r series:list<ChartSeries> r positions:list<oneui.v1.NumberItem> r labels:list<oneui.v1.StringItem>
    command inspect(index:i64,pinned:bool)
    rw title: utf8
    rw checked: bool
    r visible: bool
    r enabled: bool
    r busy: bool
    r rows: list<Item>
    command drag(phase:i64,origin_x:f64,origin_y:f64,x:f64,y:f64,alt:bool,control:bool,shift:bool)
    command click() when enabled busy busy
}
model Item key id {
    r children: list<Leaf>
    r id: utf8
    r text: utf8
}
model Leaf key id { r id: utf8 r text: utf8 }

model ChartSeries key id {r id:utf8 r name:utf8 r rgba:i64 r values:list<ChartPoint>}
model ChartPoint key id {r id:utf8 r value:f64 r valid:bool}
