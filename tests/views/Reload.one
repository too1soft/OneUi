<template view-model="Root">
  <Column view-id="root">
    <Text view-id="title" :class="title" :text="title"/>
    <Input view-id="input" v-model="title" placeholder="old"/>
    <Button view-id="button" text="Run" @click="click"/>
    <Text view-id="conditional" v-if="visible" text="conditional"/>
    <Text view-id="rows" v-for="item in rows" :key="item.id" :text="item.text"/>
    <NativeHost view-id="host" host="terminal"/>
  </Column>
</template>
