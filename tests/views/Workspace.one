<import name="Mirror" src="WorkspaceMirror.one"/>
<template view-model="Root">
  <Column view-id="root">
    <PaneGrid view-id="grid">
      <Pane view-id="panes" v-for="p in rows" :key="p.id" :pane-key="p.id">
        <Text :text="p.text"/>
        <NativeHost host="terminal"/>
        <PaneGrid view-id="nested">
          <Pane view-id="leaves" v-for="leaf in p.children" :key="leaf.id" :pane-key="leaf.id">
            <NativeHost host="terminal"/>
          </Pane>
        </PaneGrid>
      </Pane>
    </PaneGrid>
    <Mirror view-id="mirrorCall"/>
  </Column>
</template>
