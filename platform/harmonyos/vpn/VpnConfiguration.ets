import { connection, vpnExtension } from '@kit.NetworkKit';

export interface OneUiVpnPrefix { address: string; prefix: number; }
export interface OneUiVpnConfiguration {
  version: number;
  label: string;
  mtu: number;
  allowDefaultRoute: boolean;
  addresses: OneUiVpnPrefix[];
  routes: OneUiVpnPrefix[];
  dnsServers: string[];
  dnsDomains: string[];
  excludedRoutes?: OneUiVpnPrefix[];
  dnsMatchDomains?: string[];
}

// Only accept the non-secret schema generated by the shared OneUI VPN SDK.
export function parseVpnConfiguration(json: string, dynamic: boolean = false): OneUiVpnConfiguration {
  if (json.length > 65536) { throw new Error('VPN configuration size'); }
  const c: OneUiVpnConfiguration = JSON.parse(json) as OneUiVpnConfiguration;
  if (c.version !== 1 || c.label.length === 0 || c.label.length > 128 ||
      !Number.isInteger(c.mtu) || c.mtu < 1280 || c.mtu > 9000 || c.addresses.length < (dynamic ? 0 : 1) || c.addresses.length > 16 ||
      c.routes.length < (dynamic ? 0 : 1) || c.routes.length > 256 || c.dnsServers.length > 8 || c.dnsDomains.length > 16 ||
      typeof c.allowDefaultRoute !== 'boolean' || (c.excludedRoutes !== undefined && c.excludedRoutes.length > 0) ||
      (c.dnsMatchDomains !== undefined && c.dnsMatchDomains.length > 0)) {
    throw new Error('VPN configuration');
  }
  c.addresses.concat(c.routes).forEach((p: OneUiVpnPrefix) => {
    if (!Number.isInteger(p.prefix) || p.prefix < 0 || p.prefix > (p.address.includes(':') ? 128 : 32)) {
      throw new Error('VPN prefix');
    }
  });
  if (!c.allowDefaultRoute && c.routes.some((p: OneUiVpnPrefix) => p.prefix === 0)) {
    throw new Error('Default route requires explicit consent');
  }
  if (c.addresses.length === 0 && (c.routes.length > 0 || c.dnsServers.length > 0 || c.dnsDomains.length > 0)) {
    throw new Error('VPN teardown contains network settings');
  }
  return c;
}

function netAddress(address: string): connection.NetAddress {
  return { address: address, family: address.includes(':') ? 2 : 1 };
}
export function systemVpnConfiguration(c: OneUiVpnConfiguration): vpnExtension.VpnConfig {
  // HarmonyOS's current VpnConfig contract caps MTU at 1500. Reject rather
  // than silently changing a protocol engine's packet size.
  if (c.mtu > 1500) { throw new Error('VPN MTU exceeds platform limit'); }
  const addresses: connection.LinkAddress[] = c.addresses.map((p: OneUiVpnPrefix): connection.LinkAddress => {
    return { address: netAddress(p.address), prefixLength: p.prefix };
  });
  const routes: connection.RouteInfo[] = c.routes.map((p: OneUiVpnPrefix): connection.RouteInfo => {
    return {
      // Empty interface asks the OS to use the actual VPN virtual NIC. A
      // guessed TUN name can silently route to a nonexistent interface.
      interface: '',
      destination: { address: netAddress(p.address), prefixLength: p.prefix },
      gateway: netAddress(p.address.includes(':') ? '::' : '0.0.0.0'),
      hasGateway: false,
      isDefaultRoute: p.prefix === 0
    };
  });
  return { addresses: addresses, routes: routes, mtu: c.mtu, isBlocking: false,
    dnsAddresses: c.dnsServers, searchDomains: c.dnsDomains,
    isIPv4Accepted: c.addresses.some((p: OneUiVpnPrefix) => !p.address.includes(':')),
    isIPv6Accepted: c.addresses.some((p: OneUiVpnPrefix) => p.address.includes(':')) };
}
