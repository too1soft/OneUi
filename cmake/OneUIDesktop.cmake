set(_oneui_desktop_sources
    ${ONEUI_WINDOW_SERVICE_SOURCES}
    src/platform/shared/accessibility.cpp
    src/platform/shared/desktop_window.cpp
    src/platform/shared/skia_canvas.cpp
    src/platform/shared/skia_path.cpp
    src/platform/shared/skia_gl_setup.cpp)
find_package(Threads REQUIRED)
option(ONEUI_ENABLE_GPU "Build native EGL/Metal rendering (requires GPU-enabled Skia)" ON)
if(ONEUI_ENABLE_GPU AND EXISTS "${ONEUI_BUNDLED_SKIA_OUT}/args.gn")
    file(READ "${ONEUI_BUNDLED_SKIA_OUT}/args.gn" _oneui_skia_args)
    if(_oneui_skia_args MATCHES "skia_enable_ganesh[ \t]*=[ \t]*false")
        message(FATAL_ERROR "ONEUI_ENABLE_GPU requires Ganesh-enabled Skia. Rebuild with scripts/build-skia-posix.sh (ONEUI_SKIA_GPU=1), or explicitly configure -DONEUI_ENABLE_GPU=OFF for a CPU-only build.")
    endif()
endif()
set(_oneui_desktop_libraries oneui_text oneui_skia Threads::Threads)
if(APPLE)
    enable_language(OBJCXX)
    set(CMAKE_OBJCXX_STANDARD 17)
    set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
    list(APPEND _oneui_desktop_sources src/platform/macos/window_macos.mm src/platform/macos/window_operations_macos.mm src/platform/macos/native_services_macos.mm)
    list(APPEND _oneui_desktop_sources src/platform/macos/accessibility_macos.mm src/platform/macos/dock_drag_macos.mm)
    set_source_files_properties(src/platform/macos/dock_drag_macos.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    list(APPEND _oneui_desktop_sources src/platform/macos/notifications_macos.mm src/platform/macos/application_registration_macos.mm)
    set_source_files_properties(src/platform/macos/notifications_macos.mm src/platform/macos/application_registration_macos.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    list(APPEND _oneui_desktop_libraries "-framework CoreServices")
    set_source_files_properties(src/platform/macos/accessibility_macos.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    list(APPEND _oneui_desktop_libraries "-framework Cocoa" "-framework CoreText" "-framework CoreGraphics")
    set_source_files_properties(src/platform/macos/window_operations_macos.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    set_source_files_properties(src/platform/macos/window_macos.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    set_source_files_properties(src/platform/macos/native_services_macos.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    list(APPEND _oneui_desktop_libraries "-framework UniformTypeIdentifiers" "-framework UserNotifications")
    if(ONEUI_ENABLE_GPU)
        list(APPEND _oneui_desktop_sources src/platform/macos/gpu_metal.mm)
        set_source_files_properties(src/platform/macos/gpu_metal.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
        list(APPEND _oneui_desktop_libraries "-framework Metal" "-framework QuartzCore")
    endif()
else()
    enable_language(C)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(ONEUI_LINUX REQUIRED IMPORTED_TARGET x11 xrandr wayland-client wayland-cursor xkbcommon fontconfig)
    pkg_check_modules(ONEUI_DESKTOP_SERVICES REQUIRED IMPORTED_TARGET gtk+-3.0 ayatana-appindicator3-0.1)
    pkg_check_modules(ONEUI_ATSPI REQUIRED IMPORTED_TARGET atspi-2)
    list(APPEND _oneui_desktop_sources src/platform/linux/accessibility_linux.cpp)
    list(APPEND _oneui_desktop_sources src/platform/linux/notifications_linux.cpp src/platform/linux/application_registration_linux.cpp)
    # Only protocol constants are used; no libatspi runtime dependency is added.
    list(APPEND _oneui_desktop_includes ${ONEUI_ATSPI_INCLUDE_DIRS})
    list(APPEND _oneui_desktop_libraries PkgConfig::ONEUI_DESKTOP_SERVICES)
    if(ONEUI_ENABLE_GPU)
        pkg_check_modules(ONEUI_EGL REQUIRED IMPORTED_TARGET egl glesv2 wayland-egl)
        list(APPEND _oneui_desktop_sources src/platform/linux/gpu_egl.cpp)
        list(APPEND _oneui_desktop_libraries PkgConfig::ONEUI_EGL)
    endif()
    find_program(WAYLAND_SCANNER wayland-scanner)
    if(NOT WAYLAND_SCANNER)
        message(FATAL_ERROR "wayland-scanner is required for the native Wayland backend")
    endif()
    pkg_get_variable(WAYLAND_PROTOCOLS_DIR wayland-protocols pkgdatadir)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/protocols")
    set(_oneui_protocols xdg-shell text-input-unstable-v3 viewporter xdg-foreign-unstable-v2)
    if(EXISTS "${WAYLAND_PROTOCOLS_DIR}/staging/fractional-scale/fractional-scale-v1.xml")
        list(APPEND _oneui_protocols fractional-scale-v1)
        set(_oneui_fractional_scale ON)
    else()
        message(STATUS "fractional-scale-v1 unavailable: Wayland will use integer output scaling")
    endif()
    foreach(_protocol IN LISTS _oneui_protocols)
        if(_protocol STREQUAL "xdg-shell" OR _protocol STREQUAL "viewporter")
            set(_xml "${WAYLAND_PROTOCOLS_DIR}/stable/${_protocol}/${_protocol}.xml")
        elseif(_protocol STREQUAL "fractional-scale-v1")
            set(_xml "${WAYLAND_PROTOCOLS_DIR}/staging/fractional-scale/${_protocol}.xml")
        elseif(_protocol STREQUAL "xdg-foreign-unstable-v2")
            set(_xml "${WAYLAND_PROTOCOLS_DIR}/unstable/xdg-foreign/${_protocol}.xml")
        else()
            set(_xml "${WAYLAND_PROTOCOLS_DIR}/unstable/text-input/${_protocol}.xml")
        endif()
        set(_header "${CMAKE_CURRENT_BINARY_DIR}/protocols/${_protocol}-client-protocol.h")
        set(_code "${CMAKE_CURRENT_BINARY_DIR}/protocols/${_protocol}-protocol.c")
        add_custom_command(OUTPUT "${_header}" "${_code}"
            COMMAND "${WAYLAND_SCANNER}" client-header "${_xml}" "${_header}"
            COMMAND "${WAYLAND_SCANNER}" private-code "${_xml}" "${_code}"
            DEPENDS "${_xml}" VERBATIM)
        list(APPEND _oneui_desktop_sources "${_header}" "${_code}")
    endforeach()
    list(APPEND _oneui_desktop_sources src/platform/linux/window_linux.cpp
        src/platform/linux/window_x11.cpp src/platform/linux/window_properties_x11.cpp
        src/platform/linux/drop_target_x11.cpp src/platform/linux/dock_drag_x11.cpp src/platform/linux/window_wayland.cpp
        src/platform/linux/data_transfer_pipe.cpp src/platform/linux/data_device_wayland.cpp
        src/platform/linux/drop_target_wayland.cpp src/platform/linux/dock_drag_wayland.cpp
        src/platform/linux/native_services_linux.cpp)
    list(APPEND _oneui_desktop_libraries PkgConfig::ONEUI_LINUX ${CMAKE_DL_LIBS})
endif()

add_library(oneui_platform_desktop OBJECT ${_oneui_desktop_sources})
set_target_properties(oneui_platform_desktop PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(oneui_platform_desktop PRIVATE include src "${CMAKE_CURRENT_BINARY_DIR}/protocols")
target_include_directories(oneui_platform_desktop PRIVATE ${_oneui_desktop_includes})
target_link_libraries(oneui_platform_desktop PUBLIC ${_oneui_desktop_libraries})
target_compile_definitions(oneui_platform_desktop PRIVATE ONEUI_BUILDING_DLL)
option(ONEUI_ENABLE_CIRCLE_MESH_EXPERIMENT "Enable the private performance-lab circle mesh bridge" OFF)
if(ONEUI_ENABLE_CIRCLE_MESH_EXPERIMENT)
    target_compile_definitions(oneui_platform_desktop PRIVATE ONEUI_CIRCLE_MESH_EXPERIMENT=1)
endif()
if(ONEUI_ENABLE_GPU)
    target_compile_definitions(oneui_platform_desktop PRIVATE ONEUI_ENABLE_GPU=1 SK_GANESH=1)
    if(APPLE)
        target_compile_definitions(oneui_platform_desktop PRIVATE SK_METAL=1)
    else()
        target_compile_definitions(oneui_platform_desktop PRIVATE SK_GL=1)
    endif()
endif()
if(_oneui_fractional_scale)
    target_compile_definitions(oneui_platform_desktop PRIVATE ONEUI_HAVE_FRACTIONAL_SCALE=1)
endif()
if(ONEUI_ENABLE_TEST_FRAME_CAPTURE)
    target_compile_definitions(oneui_platform_desktop PRIVATE ONEUI_ENABLE_TEST_FRAME_CAPTURE=1)
endif()
add_library(oneui SHARED ${ONEUI_C_API_SOURCES}
    $<TARGET_OBJECTS:oneui_platform_desktop>)
if(ONEUI_ENABLE_TEST_FRAME_CAPTURE)
    target_compile_definitions(oneui PRIVATE ONEUI_ENABLE_TEST_FRAME_CAPTURE=1)
endif()
# Linking the object target also carries its usage requirements (e.g. Yoga).
# TARGET_OBJECTS alone silently drops those dependencies on desktop builds.
target_link_libraries(oneui PRIVATE oneui_views oneui_core ${_oneui_desktop_libraries})
target_include_directories(oneui PUBLIC include PRIVATE src)
target_compile_definitions(oneui PRIVATE ONEUI_BUILDING_DLL)
if(APPLE)
    set_target_properties(oneui PROPERTIES INSTALL_NAME_DIR "@rpath" INSTALL_RPATH "@loader_path")
else()
    set_target_properties(oneui PROPERTIES INSTALL_RPATH "$ORIGIN")
    # Keep embedded third-party symbols private, but do not hide OneUI's own
    # text archive: it implements exported APIs such as enumerateSystemFonts.
    get_target_property(_oneui_skia_main_archive oneui_skia IMPORTED_LOCATION)
    get_target_property(_oneui_skia_link_archives oneui_skia INTERFACE_LINK_LIBRARIES)
    set(_oneui_hidden_archives "")
    foreach(_archive IN LISTS _oneui_skia_main_archive _oneui_skia_link_archives)
        if(_archive MATCHES "\\.a$")
            get_filename_component(_name "${_archive}" NAME)
            list(APPEND _oneui_hidden_archives "${_name}")
        endif()
    endforeach()
    if(TARGET yogacore)
        list(APPEND _oneui_hidden_archives "$<TARGET_FILE_NAME:yogacore>")
    endif()
    if(_oneui_hidden_archives)
        list(REMOVE_DUPLICATES _oneui_hidden_archives)
        list(JOIN _oneui_hidden_archives ":" _oneui_hidden_archive_names)
        target_link_options(oneui PRIVATE "-Wl,--exclude-libs,${_oneui_hidden_archive_names}")
    endif()
endif()
add_library(OneUI::oneui ALIAS oneui)
if(ONEUI_BUILD_STATIC)
    add_library(oneui_static STATIC ${ONEUI_C_API_SOURCES}
        $<TARGET_OBJECTS:oneui_platform_desktop>)
    target_link_libraries(oneui_static PUBLIC oneui_views oneui_core ${_oneui_desktop_libraries})
    target_include_directories(oneui_static PUBLIC include PRIVATE src)
    target_compile_definitions(oneui_static PUBLIC ONEUI_STATIC)
    add_library(OneUI::oneui_static ALIAS oneui_static)
endif()
add_subdirectory(examples/gallery)
add_subdirectory(examples/remote_component_gallery)
if(APPLE)
    set_target_properties(oneui_gallery PROPERTIES MACOSX_BUNDLE TRUE
        MACOSX_BUNDLE_GUI_IDENTIFIER "org.oneui.gallery")
    set_target_properties(oneui_gallery PROPERTIES INSTALL_RPATH "@executable_path/../Frameworks")
else()
    set_target_properties(oneui_gallery PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OneUIInstall.cmake")
if(BUILD_TESTING)
    oneui_register_native_tests()
endif()
