include_guard(GLOBAL)
option(ONEUI_STATIC_IPO "Enable toolchain-specific IPO for source-built static applications" OFF)
if(ONEUI_STATIC_IPO)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT oneui_ipo_supported OUTPUT oneui_ipo_error LANGUAGES CXX)
    if(NOT oneui_ipo_supported)
        message(FATAL_ERROR "Static IPO is unavailable: ${oneui_ipo_error}")
    endif()
endif()

# DLL and archive consumers need differently compiled objects. A definition on
# the final archive cannot undo dllexport directives in a reused DLL object.
function(oneui_static_objects target original)
    get_target_property(kind ${original} TYPE)
    if(kind STREQUAL "STATIC_LIBRARY")
        add_library(${target} STATIC)
    else()
        add_library(${target} OBJECT)
    endif()
    foreach(property SOURCES INCLUDE_DIRECTORIES SYSTEM_INCLUDE_DIRECTORIES
            COMPILE_OPTIONS COMPILE_FEATURES POSITION_INDEPENDENT_CODE
            MSVC_RUNTIME_LIBRARY)
        get_target_property(value ${original} ${property})
        if(value AND NOT value MATCHES "-NOTFOUND$")
            if(property STREQUAL "SOURCES")
                get_target_property(source_directory ${original} SOURCE_DIR)
                set(absolute_sources "")
                foreach(source IN LISTS value)
                    if(NOT IS_ABSOLUTE "${source}" AND NOT source MATCHES "^\\$<")
                        set(source "${source_directory}/${source}")
                    endif()
                    list(APPEND absolute_sources "${source}")
                endforeach()
                set(value ${absolute_sources})
            endif()
            set_property(TARGET ${target} PROPERTY ${property} "${value}")
        endif()
    endforeach()
    get_target_property(definitions ${original} COMPILE_DEFINITIONS)
    if(definitions)
        list(REMOVE_ITEM definitions ONEUI_BUILDING_DLL)
        target_compile_definitions(${target} PRIVATE ${definitions})
    endif()
    target_compile_definitions(${target} PUBLIC ONEUI_STATIC)
    get_target_property(interface_definitions ${original} INTERFACE_COMPILE_DEFINITIONS)
    if(interface_definitions)
        list(REMOVE_ITEM interface_definitions ONEUI_BUILDING_DLL)
        target_compile_definitions(${target} INTERFACE ${interface_definitions})
    endif()
    get_target_property(includes ${original} INTERFACE_INCLUDE_DIRECTORIES)
    if(includes)
        target_include_directories(${target} INTERFACE ${includes})
    endif()
    get_target_property(libraries ${original} LINK_LIBRARIES)
    if(libraries)
        foreach(dependency oneui_text oneui_core oneui_views oneui_platform_win32 oneui_platform_desktop)
            list(TRANSFORM libraries REPLACE "^${dependency}$" "${dependency}_static_objects")
        endforeach()
        target_link_libraries(${target} PUBLIC ${libraries})
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /Gy /Gw)
    else()
        target_compile_options(${target} PRIVATE -ffunction-sections -fdata-sections)
    endif()
    if(ONEUI_STATIC_IPO)
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
    endif()
endfunction()

function(oneui_prepare_static_objects platform)
    foreach(original oneui_text oneui_core oneui_views ${platform})
        if(NOT TARGET ${original}_static_objects)
            oneui_static_objects(${original}_static_objects ${original})
            if(original STREQUAL "oneui_text")
                # Preserve the published archive name used by C/Rust SDKs.
                set_target_properties(${original}_static_objects PROPERTIES
                    OUTPUT_NAME oneui_text
                    ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/static")
            endif()
        endif()
    endforeach()
endfunction()

function(oneui_static_link_options target)
    if(ONEUI_STATIC_IPO)
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /Gy /Gw)
        target_link_options(${target} INTERFACE "$<$<NOT:$<CONFIG:Debug>>:/OPT:REF>"
            "$<$<NOT:$<CONFIG:Debug>>:/OPT:ICF>")
    elseif(APPLE)
        target_link_options(${target} INTERFACE "$<$<NOT:$<CONFIG:Debug>>:-Wl,-dead_strip>")
    else()
        target_link_options(${target} INTERFACE "$<$<NOT:$<CONFIG:Debug>>:-Wl,--gc-sections>")
    endif()
endfunction()
