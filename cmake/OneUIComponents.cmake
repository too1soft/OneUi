include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OneUIPluginRuntimes.cmake")

# Embed the exact versioned document consumed by oneui-viewc.
function(oneui_component_contract target)
    cmake_parse_arguments(COMP "" "SOURCE;NAME" "" ${ARGN})
    if(NOT TARGET "${target}" OR NOT COMP_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "oneui_component_contract requires a target and C identifier NAME")
    endif()
    get_filename_component(_file "${COMP_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    file(READ "${_file}" _text)
    string(SHA256 _hash "${_text}")
    string(SUBSTRING "${_hash}" 0 10 _hash)
    set(_delimiter "oneui${_hash}")
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/oneui-generated/${COMP_NAME}")
    file(MAKE_DIRECTORY "${_output}")
    file(WRITE "${_output}/${COMP_NAME}.h"
        "#pragma once\ninline constexpr char ${COMP_NAME}[] = R\"${_delimiter}(${_text})${_delimiter}\";\n")
    target_include_directories("${target}" PRIVATE "${_output}")
endfunction()

# Call before oneui_target_view so the compiler inherits package contracts.
function(oneui_target_components application)
    cmake_parse_arguments(COMP "" "REGISTRAR" "COMPONENTS" ${ARGN})
    if(COMP_UNPARSED_ARGUMENTS OR NOT TARGET "${application}" OR
       NOT COMP_REGISTRAR MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "oneui_target_components requires target, REGISTRAR and COMPONENTS")
    endif()
    get_target_property(_existing "${application}" ONEUI_COMPONENT_REGISTRAR)
    if(_existing)
        message(FATAL_ERROR "Components already configured for ${application}")
    endif()
    set(_includes "")
    set(_calls "")
    set(_files "")
    set(_ids "")
    foreach(_target IN LISTS COMP_COMPONENTS)
        foreach(_key ID ENTRY HEADER CONTRACT)
            get_target_property(_${_key} "${_target}" "ONEUI_COMPONENT_${_key}")
        endforeach()
        if(NOT _ID MATCHES "^[a-z][a-z0-9_.-]*$" OR _ID IN_LIST _ids OR
           NOT _ENTRY MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR
           NOT _HEADER MATCHES "^[A-Za-z0-9_./-]+$" OR NOT EXISTS "${_CONTRACT}")
            message(FATAL_ERROR "Invalid/duplicate component package: ${_target}")
        endif()
        list(APPEND _ids "${_ID}")
        list(APPEND _files "${_CONTRACT}")
        string(APPEND _includes "#include \"${_HEADER}\"\n")
        string(APPEND _calls "    result = oneui_component_registry_register_v1(registry, ${_ENTRY}());\n    if (result != ONEUI_VIEW_OK) return result;\n")
    endforeach()
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/oneui-generated/${COMP_REGISTRAR}")
    file(MAKE_DIRECTORY "${_output}")
    file(WRITE "${_output}/oneui_generated_components.h"
        "#pragma once\n#include \"oneui/oneui_component_c_api.h\"\n#ifdef __cplusplus\nextern \"C\" {\n#endif\nOneUiViewResult ${COMP_REGISTRAR}(OneUiComponentRegistry *registry);\n#ifdef __cplusplus\n}\n#endif\n")
    file(WRITE "${_output}/components.cpp"
        "#include \"oneui_generated_components.h\"\n${_includes}\nOneUiViewResult ${COMP_REGISTRAR}(OneUiComponentRegistry *registry) {\n    if (!registry) return ONEUI_VIEW_INVALID_ARGUMENT;\n    OneUiViewResult result = ONEUI_VIEW_OK;\n${_calls}    return result;\n}\n")
    target_sources("${application}" PRIVATE "${_output}/components.cpp")
    target_include_directories("${application}" PRIVATE "${_output}")
    target_link_libraries("${application}" PRIVATE OneUI::oneui ${COMP_COMPONENTS})
    set_target_properties("${application}" PROPERTIES ONEUI_COMPONENT_REGISTRAR "${COMP_REGISTRAR}"
        ONEUI_COMPONENT_FILES "${_files}")
    _oneui_stage_plugin_runtimes("${application}" OneUI::oneui ${COMP_COMPONENTS})
endfunction()
