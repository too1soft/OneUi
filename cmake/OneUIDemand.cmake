include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OneUIStatic.cmake")

# Call once after all oneui_target_view declarations. Requirements from every
# imported template and conditional branch are regenerated with their views.
function(oneui_target_demand target)
    cmake_parse_arguments(DEMAND "FULL_RUNTIME" "" "DYNAMIC_COMPONENTS;REQUIREMENTS" ${ARGN})
    if(DEMAND_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown demand-build arguments: ${DEMAND_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT TARGET oneui_views_static_objects)
        message(FATAL_ERROR "oneui_target_demand needs the source-built OneUI static runtime")
    endif()
    get_target_property(existing ${target} ONEUI_DEMAND_RUNTIME)
    if(existing)
        message(FATAL_ERROR "oneui_target_demand must be called once, after declaring all views")
    endif()
    get_target_property(requirements ${target} ONEUI_VIEW_REQUIREMENTS)
    if(NOT requirements)
        set(requirements "")
    endif()
    foreach(manifest IN LISTS DEMAND_REQUIREMENTS)
        get_filename_component(manifest "${manifest}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND requirements "${manifest}")
    endforeach()
    if(NOT requirements)
        message(FATAL_ERROR "oneui_target_demand needs at least one oneui_target_view")
    endif()
    set_property(TARGET ${target} PROPERTY ONEUI_VIEW_REQUIREMENTS "${requirements}")
    get_target_property(root oneui_core SOURCE_DIR)
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/oneui-demand/${target}")
    set(inputs "${directory}/manifests.txt")
    set(header "${directory}/components.h")
    file(GENERATE OUTPUT "${inputs}"
        CONTENT "$<JOIN:$<TARGET_PROPERTY:${target},ONEUI_VIEW_REQUIREMENTS>,\n>\n")
    list(JOIN DEMAND_DYNAMIC_COMPONENTS "," extras)
    set(full "")
    if(DEMAND_FULL_RUNTIME)
        set(full --full)
    endif()
    add_custom_command(OUTPUT "${header}"
        COMMAND "${Python3_EXECUTABLE}" "${root}/scripts/merge-view-requirements.py"
            --manifests "${inputs}" --output "${header}" --extra "${extras}" ${full}
        DEPENDS ${requirements} "${inputs}" "${root}/scripts/merge-view-requirements.py"
        VERBATIM)
    add_custom_target(${target}_oneui_selection DEPENDS "${header}")
    set(views ${target}_oneui_views)
    oneui_static_objects(${views} oneui_views_static_objects)
    add_dependencies(${views} ${target}_oneui_selection)
    target_compile_definitions(${views} PRIVATE "ONEUI_COMPONENT_SELECTION_HEADER=\"${header}\"")
    set(runtime ${target}_oneui_runtime)
    oneui_static_objects(${runtime} oneui_static)
    get_target_property(sources ${runtime} SOURCES)
    list(TRANSFORM sources REPLACE "TARGET_OBJECTS:oneui_views_static_objects" "TARGET_OBJECTS:${views}")
    set_property(TARGET ${runtime} PROPERTY SOURCES "${sources}")
    oneui_static_link_options(${runtime})
    get_target_property(libraries ${target} LINK_LIBRARIES)
    if(libraries)
        list(REMOVE_ITEM libraries oneui_static OneUI::oneui_static)
    else()
        set(libraries "")
    endif()
    set_property(TARGET ${target} PROPERTY LINK_LIBRARIES "${runtime};${libraries}")
    if(ONEUI_STATIC_IPO)
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
    endif()
    set_property(TARGET ${target} PROPERTY ONEUI_DEMAND_RUNTIME ${runtime})
endfunction()
