    target_link_libraries(oneui_skia_path_cache_tests PRIVATE oneui_skia)
    add_test(NAME oneui_skia_path_cache_tests COMMAND oneui_skia_path_cache_tests)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        pkg_check_modules(ONEUI_XTEST QUIET IMPORTED_TARGET xtst)
