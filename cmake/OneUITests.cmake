            # Opt-in: this test injects pointer events into the X server.
            add_executable(oneui_x11_dock_drag_tests tests/x11_dock_drag_tests.cpp)
            target_link_libraries(oneui_x11_dock_drag_tests PRIVATE oneui PkgConfig::ONEUI_XTEST PkgConfig::ONEUI_LINUX)
        endif()
        find_program(ONEUI_DBUS_RUN_SESSION dbus-run-session)
