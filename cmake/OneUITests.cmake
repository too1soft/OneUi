function(oneui_register_native_tests)
    oneui_add_native_test(oneui_application_lifecycle_tests tests/application_lifecycle_tests.cpp)
    target_sources(oneui_application_lifecycle_tests PRIVATE "${PROJECT_SOURCE_DIR}/tests/application_modal_tests.cpp")
