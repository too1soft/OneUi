            set_tests_properties(oneui_linux_native_services_tests PROPERTIES TIMEOUT 30 LABELS "native-integration")
        endif()
    endif()
    if(APPLE)
        oneui_add_native_test(oneui_macos_backend_tests tests/macos_backend_tests.mm)
        target_include_directories(oneui_macos_backend_tests PRIVATE src)
        target_compile_options(oneui_macos_backend_tests PRIVATE -fobjc-arc)
