    oneui_add_native_test(oneui_dock_gesture_tests tests/dock_gesture_tests.cpp)
    if(APPLE)
        # Opt-in: requires an explicit OS grant for automated input.
        add_executable(oneui_macos_dock_drag_tests tests/macos_dock_drag_tests.mm)
        target_compile_options(oneui_macos_dock_drag_tests PRIVATE -fobjc-arc)
        target_link_libraries(oneui_macos_dock_drag_tests PRIVATE oneui "-framework Cocoa" "-framework CoreGraphics")
    endif()
    set_tests_properties(oneui_dock_session_tests PROPERTIES TIMEOUT 30)
    set_tests_properties(oneui_application_lifecycle_tests PROPERTIES TIMEOUT 20)
    add_executable(oneui_skia_path_cache_tests tests/skia_path_cache_tests.cpp src/platform/shared/skia_path.cpp)
