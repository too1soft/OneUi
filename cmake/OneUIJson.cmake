enable_language(C)
add_library(oneui_json STATIC src/data/json.cpp third_party/yyjson/src/yyjson.c)
add_library(OneUI::json ALIAS oneui_json)
target_include_directories(oneui_json PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:include>
    PRIVATE third_party/yyjson/src)
target_compile_features(oneui_json PUBLIC cxx_std_17)
set_target_properties(oneui_json PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME json)
include(GNUInstallDirs)
install(TARGETS oneui_json EXPORT OneUIJsonTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
install(EXPORT OneUIJsonTargets NAMESPACE OneUI:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIJson")
install(FILES "${CMAKE_CURRENT_LIST_DIR}/OneUIJsonConfig.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIJson")
install(FILES include/oneui/json.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/oneui")
install(FILES third_party/yyjson/LICENSE DESTINATION "${CMAKE_INSTALL_DATADIR}/oneui/licenses/yyjson")
if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
    add_executable(oneui_json_tests tests/data/json_tests.cpp)
    target_link_libraries(oneui_json_tests PRIVATE OneUI::json)
    add_test(NAME oneui_json_tests COMMAND oneui_json_tests)
endif()
