# Optional OS VPN services, deliberately independent of Skia and desktop ABI.
option(ONEUI_VPN_SHARED "Build the optional VPN SDK as a shared library" OFF)
option(ONEUI_VPN_ANDROID_NATIVE "Build the backend-independent Android JNI packet bridge" OFF)
option(ONEUI_VPN_JSON "Build the optional strict JSON configuration adapter" OFF)
option(ONEUI_VPN_POSIX_NATIVE "Build portable POSIX packet and native callback services" OFF)
if(ONEUI_VPN_SHARED)
    set(_oneui_vpn_type SHARED)
else()
    set(_oneui_vpn_type STATIC)
endif()
add_library(oneui_vpn ${_oneui_vpn_type}
    src/vpn/config.cpp src/vpn/session.cpp src/vpn/c_api.cpp)
add_library(OneUI::vpn ALIAS oneui_vpn)
find_package(Threads REQUIRED)
target_link_libraries(oneui_vpn PUBLIC Threads::Threads)
target_include_directories(oneui_vpn PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:include>)
target_compile_features(oneui_vpn PUBLIC cxx_std_17)
target_compile_definitions(oneui_vpn PRIVATE ONEUI_VPN_BUILD)
if(NOT ONEUI_VPN_SHARED)
    target_compile_definitions(oneui_vpn PUBLIC ONEUI_VPN_STATIC)
endif()
set_target_properties(oneui_vpn PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME vpn)
include(GNUInstallDirs)
install(TARGETS oneui_vpn EXPORT OneUIVpnTargets
    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
    LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
install(DIRECTORY include/oneui/vpn DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/oneui")
install(FILES bindings/go/oneuivpn/native/native_bridge.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/oneui/vpn")
if(ONEUI_VPN_POSIX_NATIVE)
    if(NOT UNIX AND NOT ANDROID)
        message(FATAL_ERROR "ONEUI_VPN_POSIX_NATIVE requires POSIX packet descriptors")
    endif()
    add_library(oneui_vpn_posix STATIC src/vpn/backend_posix.cpp src/vpn/posix_packet_pump.cpp
        src/mobile/native_service_queue.cpp src/mobile/native_module_posix.cpp src/mobile/atomic_blob_files.cpp
        src/mobile/private_directory.cpp src/mobile/local_channel.cpp)
    add_library(OneUI::vpn_posix ALIAS oneui_vpn_posix)
    target_compile_features(oneui_vpn_posix PUBLIC cxx_std_17)
    target_include_directories(oneui_vpn_posix PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/bindings/go/oneuivpn/native>
        $<INSTALL_INTERFACE:include>)
    target_link_libraries(oneui_vpn_posix PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
    set_target_properties(oneui_vpn_posix PROPERTIES EXPORT_NAME vpn_posix POSITION_INDEPENDENT_CODE ON)
    install(TARGETS oneui_vpn_posix EXPORT OneUIVpnPosixTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
    install(FILES include/oneui/mobile/native_service_queue.h include/oneui/mobile/native_module_posix.h
        include/oneui/mobile/native_module.h include/oneui/mobile/atomic_blob_files.h
        include/oneui/mobile/private_directory.h include/oneui/mobile/local_channel.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/oneui/mobile")
    install(EXPORT OneUIVpnPosixTargets NAMESPACE OneUI:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIVpnPosix")
    install(FILES "${CMAKE_CURRENT_LIST_DIR}/OneUIVpnPosixConfig.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIVpnPosix")
endif()
if(ONEUI_VPN_JSON OR ONEUI_VPN_ANDROID_NATIVE)
    if(NOT TARGET oneui_json)
        include("${CMAKE_CURRENT_LIST_DIR}/OneUIJson.cmake")
    endif()
    add_library(oneui_vpn_json STATIC src/vpn/config_json.cpp)
    add_library(OneUI::vpn_json ALIAS oneui_vpn_json)
    target_link_libraries(oneui_vpn_json PUBLIC oneui_vpn PRIVATE oneui_json)
    if(WIN32)
        target_link_libraries(oneui_vpn_json PRIVATE ws2_32)
    endif()
    set_target_properties(oneui_vpn_json PROPERTIES EXPORT_NAME vpn_json POSITION_INDEPENDENT_CODE ON)
    install(TARGETS oneui_vpn_json EXPORT OneUIVpnJsonTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
    install(EXPORT OneUIVpnJsonTargets NAMESPACE OneUI:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIVpnJson")
    install(FILES "${CMAKE_CURRENT_LIST_DIR}/OneUIVpnJsonConfig.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIVpnJson")
endif()
if(ONEUI_VPN_ANDROID_NATIVE)
    if(NOT ANDROID)
        message(FATAL_ERROR "ONEUI_VPN_ANDROID_NATIVE requires an Android toolchain")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/OneUINativeServicesAndroid.cmake")
    add_library(oneui_vpn_native SHARED platform/android/vpn/native_packet_jni.cpp src/vpn/backend_posix.cpp platform/android/vpn/native_session_jni.cpp)
    add_library(OneUI::vpn_android_native ALIAS oneui_vpn_native)
    target_include_directories(oneui_vpn_native PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/bindings/go/oneuivpn/native")
    target_compile_features(oneui_vpn_native PRIVATE cxx_std_17)
    target_link_libraries(oneui_vpn_native PRIVATE dl oneui_vpn_json)
    target_link_options(oneui_vpn_native PRIVATE -Wl,--no-undefined -Wl,-z,max-page-size=16384)
    set_target_properties(oneui_vpn_native PROPERTIES EXPORT_NAME vpn_android_native)
    install(TARGETS oneui_vpn_native EXPORT OneUIVpnTargets LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}")
endif()
install(EXPORT OneUIVpnTargets NAMESPACE OneUI:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIVpn")
install(FILES "${CMAKE_CURRENT_LIST_DIR}/OneUIVpnConfig.cmake"
    DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUIVpn")
install(DIRECTORY platform/android/java/net/too1/oneui/vpn
    DESTINATION "${CMAKE_INSTALL_DATADIR}/oneui/android/java/net/too1/oneui")
install(DIRECTORY platform/ios/vpn/ DESTINATION "${CMAKE_INSTALL_DATADIR}/oneui/ios/vpn")
install(DIRECTORY platform/harmonyos/vpn/ DESTINATION "${CMAKE_INSTALL_DATADIR}/oneui/harmonyos/vpn")
if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
    enable_language(C)
    add_executable(oneui_vpn_tests tests/vpn/session_tests.cpp)
    target_link_libraries(oneui_vpn_tests PRIVATE OneUI::vpn)
    add_test(NAME oneui_vpn_tests COMMAND oneui_vpn_tests)
    if(TARGET oneui_vpn_posix)
        add_executable(oneui_vpn_posix_tests tests/vpn/posix_packet_tests.cpp)
        target_link_libraries(oneui_vpn_posix_tests PRIVATE oneui_vpn_posix)
        add_test(NAME oneui_vpn_posix_tests COMMAND oneui_vpn_posix_tests)
        add_executable(oneui_native_service_queue_tests tests/mobile/native_service_queue_tests.cpp)
        target_link_libraries(oneui_native_service_queue_tests PRIVATE oneui_vpn_posix)
        add_test(NAME oneui_native_service_queue_tests COMMAND oneui_native_service_queue_tests)
    endif()
    add_executable(oneui_vpn_c_tests tests/vpn/c_api_tests.c)
    target_link_libraries(oneui_vpn_c_tests PRIVATE OneUI::vpn)
    set_target_properties(oneui_vpn_c_tests PROPERTIES LINKER_LANGUAGE CXX)
    add_test(NAME oneui_vpn_c_tests COMMAND oneui_vpn_c_tests)
    if(TARGET oneui_vpn_json)
        add_executable(oneui_vpn_json_tests tests/vpn/json_config_tests.cpp)
        target_link_libraries(oneui_vpn_json_tests PRIVATE OneUI::vpn_json)
        add_test(NAME oneui_vpn_json_tests COMMAND oneui_vpn_json_tests)
    endif()
endif()
