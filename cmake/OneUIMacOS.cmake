if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR (CMAKE_HOST_APPLE AND NOT CMAKE_SYSTEM_NAME))
    if(NOT DEFINED CMAKE_OSX_DEPLOYMENT_TARGET)
        if(NOT "$ENV{MACOSX_DEPLOYMENT_TARGET}" STREQUAL "")
            set(CMAKE_OSX_DEPLOYMENT_TARGET "$ENV{MACOSX_DEPLOYMENT_TARGET}" CACHE STRING "Minimum macOS version")
        else()
            set(CMAKE_OSX_DEPLOYMENT_TARGET "13.0" CACHE STRING "Minimum macOS version")
        endif()
    endif()
    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET OR CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "13.0")
        message(FATAL_ERROR "OneUI requires CMAKE_OSX_DEPLOYMENT_TARGET >= 13.0, matching the bundled Skia baseline")
    endif()
endif()
