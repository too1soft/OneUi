if(TARGET oneui_native_services)
    return()
endif()
if(NOT ANDROID)
    message(FATAL_ERROR "Native Android services require an Android toolchain")
endif()
add_library(oneui_native_services SHARED platform/android/native/native_module_jni.cpp src/mobile/native_module_posix.cpp)
target_include_directories(oneui_native_services PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
target_compile_features(oneui_native_services PRIVATE cxx_std_17)
target_link_libraries(oneui_native_services PRIVATE dl)
target_link_options(oneui_native_services PRIVATE -Wl,--no-undefined -Wl,-z,max-page-size=16384)
set_target_properties(oneui_native_services PROPERTIES EXPORT_NAME native_services_android)
include(GNUInstallDirs)
install(TARGETS oneui_native_services EXPORT OneUINativeServicesTargets LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}")
install(EXPORT OneUINativeServicesTargets NAMESPACE OneUI:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUINativeServices")
install(FILES "${CMAKE_CURRENT_LIST_DIR}/OneUINativeServicesConfig.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OneUINativeServices")
install(FILES include/oneui/mobile/native_module.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/oneui/mobile")
install(DIRECTORY platform/android/java/net/too1/oneui/nativebridge DESTINATION "${CMAKE_INSTALL_DATADIR}/oneui/android/java/net/too1/oneui")
