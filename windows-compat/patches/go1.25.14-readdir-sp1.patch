+++ b/src/internal/syscall/windows/readdir_sp1_windows.go
@@ -0,0 +1,50 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package windows
+
+import (
+	"runtime"
+	"syscall"
+	"unsafe"
+)
+
+var procNtQueryDirectoryFile = modntdll.NewProc("NtQueryDirectoryFile")
+
+// ReadDirectoryInformation keeps the handle-relative enumeration used by
+// os.Root. Win7 lacks the Win32 FileFullDirectoryInfo classes, but provides
+// the equivalent native FileFullDirectoryInformation class. Never fall back
+// to reopening a directory by its path (which could have been replaced).
+func ReadDirectoryInformation(handle syscall.Handle, class uint32, info *byte, size uint32) error {
+	err := GetFileInformationByHandleEx(handle, class, info, size)
+	if err != syscall.Errno(87) || (class != FileFullDirectoryInfo && class != FileFullDirectoryRestartInfo) {
+		return err
+	}
+	var restart uintptr
+	if class == FileFullDirectoryRestartInfo {
+		restart = 1
+	}
+	var iosb IO_STATUS_BLOCK
+	r1, _, _ := syscall.SyscallN(procNtQueryDirectoryFile.Addr(), uintptr(handle), 0, 0, 0,
+		uintptr(unsafe.Pointer(&iosb)), uintptr(unsafe.Pointer(info)), uintptr(size), 2, 0, 0, restart)
+	status := NTStatus(r1)
+	if status == 0x103 { // STATUS_PENDING: do not return while the buffer is in use.
+		_, waitErr := syscall.WaitForSingleObject(handle, syscall.INFINITE)
+		if waitErr != nil {
+			// A valid directory handle remains owned by os.File during this call.
+			// A caller concurrently closing a raw handle violates that ownership.
+			return waitErr
+		}
+		status = iosb.Status
+	}
+	runtime.KeepAlive(info)
+	runtime.KeepAlive(&iosb)
+	if status != 0 {
+		return status.Errno()
+	}
+	if iosb.Information == 0 {
+		return syscall.ERROR_NO_MORE_FILES
+	}
+	return nil
+}
